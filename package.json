{
  "name": "rescomail",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "dev:web": "turbo run dev --filter web",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "pnpm --filter web test && pnpm --filter ai-service check"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "prettier": "^3.7.4",
    "turbo": "^2.9.14",
