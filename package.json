  "pnpm": {
    "overrides": {
      "@babel/core": "7.29.6",
      "@opentelemetry/core": "2.8.0",
      "@hono/node-server": "2.0.10",
      "body-parser": "2.3.0",
      "brace-expansion@>=3.0.0": "5.0.8",
      "cookie": "0.7.2",
      "engine.io": "6.6.7",
      "effect": "3.21.0",
      "esbuild": "0.28.1",
      "fast-uri": "3.1.4",
      "hono": "4.12.27",
      "js-yaml": "4.3.0",
      "postcss": "8.5.18",
      "protobufjs": "7.6.5",
      "sharp": "0.35.0",
      "systeminformation": "5.31.7",
      "ws": "8.21.0"
