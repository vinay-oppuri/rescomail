# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rescomail

# Better Auth
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-characters

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email
RESEND_API_KEY=
RESEND_FROM_EMAIL="Rescomail <noreply@example.com>"

# UploadThing
UPLOADTHING_TOKEN=

# AI service integration (web → AI service trust boundary)
# Set the same value in apps/ai-service/.env as AI_SERVICE_API_KEY.
AI_SERVICE_API_KEY=replace-with-a-long-random-token

# Resume parsing pipeline (AI service → web webhook trust boundary)
# Set the same value in apps/ai-service/.env as RESUME_PARSER_API_KEY.
RESUME_PARSER_WEBHOOK_URL=http://localhost:3000/api/parse
RESUME_PARSER_API_KEY=replace-with-a-different-long-random-token
AI_SERVICE_URL=http://localhost:8000
TAVILY_API_KEY=

# AI service settings (these go in apps/ai-service/.env, not here)
# GEMINI_API_KEY=          ← required in apps/ai-service/.env; service refuses to start without it
# GEMINI_MODEL=gemini-2.5-flash
# AI_SERVICE_API_KEY=      ← same token as above, set in ai-service/.env
# RESUME_PARSER_API_KEY=   ← same token as above, set in ai-service/.env
# RESUME_FILE_ALLOWED_HOSTS=localhost
# RESUME_MAX_DOWNLOAD_BYTES=10485760
# RESCOMAIL_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
# RESCOMAIL_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L12-v2
# RESCOMAIL_ALLOW_HASHED_EMBEDDING_FALLBACK=0  ← set to 1 only for local dev
