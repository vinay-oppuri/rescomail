# =============================================================================
# Rescomail AI Service — Dockerfile.worker
# Production image for the Celery worker (ATS, cold mail, job digest tasks).
# =============================================================================

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV RESCOMAIL_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
ENV RESCOMAIL_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L12-v2

WORKDIR /app

COPY pyproject.toml .
RUN pip install --no-cache-dir ".[dev]" || pip install --no-cache-dir .

# Pre-download embedding models
RUN python -c "\
import os; \
from sentence_transformers import CrossEncoder, SentenceTransformer; \
SentenceTransformer(os.environ['RESCOMAIL_EMBEDDING_MODEL']); \
CrossEncoder(os.environ['RESCOMAIL_RERANKER_MODEL'])"

COPY app ./app

# Run Celery worker with beat scheduler
# In production, run beat separately to avoid duplicate task scheduling.
CMD ["celery", "-A", "app.tasks", "worker", "--loglevel=info", "--concurrency=2"]
