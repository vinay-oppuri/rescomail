# =============================================================================
# Rescomail AI Service — Dockerfile.api
# Production image for the FastAPI API server.
# =============================================================================

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV RESCOMAIL_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
ENV RESCOMAIL_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L12-v2

WORKDIR /app

# Install dependencies
COPY pyproject.toml .
RUN pip install --no-cache-dir ".[dev]" || pip install --no-cache-dir .

# Pre-download embedding models at build time to avoid runtime delays
RUN python -c "\
import os; \
from sentence_transformers import CrossEncoder, SentenceTransformer; \
SentenceTransformer(os.environ['RESCOMAIL_EMBEDDING_MODEL']); \
CrossEncoder(os.environ['RESCOMAIL_RERANKER_MODEL'])"

COPY app ./app
COPY docker/start.sh ./start.sh
RUN chmod +x ./start.sh

EXPOSE 8000

CMD ["./start.sh"]