# Rescomail AI Service — Environment Variables
# Copy this file to .env and configure the values.

ENVIRONMENT=development
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GROQ_API_KEY=
AI_SERVICE_API_KEY=
AI_SERVICE_PREVIOUS_API_KEY=

RESUME_FILE_ALLOWED_HOSTS=utfs.io,ufs.sh
RESUME_MAX_DOWNLOAD_BYTES=10485760
RESUME_MAX_PAGES=20

LOG_LEVEL=INFO
# RATE_LIMIT_PER_MINUTE=60
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
TAVILY_API_KEY=
