GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

RESUME_PARSER_API_KEY= 

AI_SERVICE_API_KEY=     

TAVILY_API_KEY=

# -----------------------------------------------------------------------------
# Resume file download restrictions
# RESUME_FILE_ALLOWED_HOSTS : the host(s) the AI service is allowed to download
#   resume files FROM — this is your file storage CDN (e.g. UploadThing), NOT
#   your web app URL. Comma-separated. Leave empty to disable the check (local dev).
#   Example for UploadThing: utfs.io
# -----------------------------------------------------------------------------
RESUME_FILE_ALLOWED_HOSTS=utfs.io
RESUME_MAX_DOWNLOAD_BYTES=10485760