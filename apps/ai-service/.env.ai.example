# =============================================================================
# Rescomail AI Service — Environment Variables
# Copy this file to .env and fill in the values.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM — Google Gemini (REQUIRED)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# -----------------------------------------------------------------------------
# Service Authentication (REQUIRED)
# Used to authenticate inbound requests from the Rescomail web app.
# Generate a strong random string: openssl rand -hex 32
# -----------------------------------------------------------------------------
AI_SERVICE_API_KEY=

# -----------------------------------------------------------------------------
# Resume File Download Restrictions
# RESUME_FILE_ALLOWED_HOSTS: comma-separated hostnames the service may download
#   PDFs from (e.g. your UploadThing CDN). Leave empty to disable (local dev only).
# -----------------------------------------------------------------------------
RESUME_FILE_ALLOWED_HOSTS=utfs.io
RESUME_MAX_DOWNLOAD_BYTES=10485760

# -----------------------------------------------------------------------------
# Redis — Celery broker + embedding cache (required for Celery / embedding cache)
# Format: redis://<host>:<port>/<db>
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Logging
# Valid values: DEBUG, INFO, WARNING, ERROR, CRITICAL
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Rate Limiting
# Maximum number of requests per minute per IP address.
# -----------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=60

# -----------------------------------------------------------------------------
# Jobs Feature (optional — leave empty to disable)
# -----------------------------------------------------------------------------

# JSearch via RapidAPI — https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
JSEARCH_API_KEY='15653ef90dmsh77d4dbb01bf690ep1bacfejsnec3713827cbb'

# Adzuna — https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_API_KEY=

# Resend — https://resend.com (email delivery for job digests)
RESEND_API_KEY=

# Tavily API — https://tavily.com (RAG scraping for company context)
TAVILY_API_KEY=

# -----------------------------------------------------------------------------
# Embedding Models (change only if you swap the sentence-transformers models)
# -----------------------------------------------------------------------------
RESCOMAIL_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
RESCOMAIL_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L12-v2
RESCOMAIL_ALLOW_HASHED_EMBEDDING_FALLBACK=0
