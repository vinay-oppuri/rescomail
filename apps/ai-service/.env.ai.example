# Required
ENVIRONMENT=development
AI_SERVICE_API_KEY=
GEMINI_API_KEY=

# Optional AI fallbacks and enrichment
GEMINI_MODEL=gemini-3.5-flash
GROQ_API_KEY=
TAVILY_API_KEY=

# Optional key rotation
AI_SERVICE_PREVIOUS_API_KEY=

# Resume PDF safety limits
RESUME_FILE_ALLOWED_HOSTS=utfs.io,ufs.sh
RESUME_MAX_DOWNLOAD_BYTES=10485760
RESUME_MAX_PAGES=20

# Operations
RATE_LIMIT_PER_MINUTE=60
LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
